# Public base URL of the site. Used for canonical URLs, sitemap.xml and robots.txt.
# Local: http://localhost:3000 — Production: https://eliatolin.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Simple Analytics: the domain as registered in the Simple Analytics dashboard.
# Both are needed — the NEXT_PUBLIC_ one is baked into the client bundle at
# build time, the other configures the server-side proxy rewrites.
# Leave empty locally to keep analytics off during development.
NEXT_PUBLIC_SIMPLE_ANALYTICS_HOSTNAME=
SIMPLE_ANALYTICS_HOSTNAME=
